---
import BaseLayout from './BaseLayout.astro';
import PostNav from '../components/post/PostNav.astro';
import SmartImage from '../components/ui/SmartImage.astro';
import TableOfContents from '../components/islands/TableOfContents.astro';
import Giscus from '../components/islands/Giscus.astro';
import MermaidLoader from '../components/islands/MermaidLoader.astro';
import { Icon } from 'astro-icon/components';
import { GISCUS, SITE, type Locale } from '../config';
import { useTranslations, stripLocale, formatDate, isoDate, localizedPath } from '../i18n/utils';
import { readingTime } from '../utils/reading-time';
import {
  type Post,
  tagPath,
  categoryPath,
  getTranslations,
  postPath,
  postSlug,
  heroImage,
  heroImageSrc,
  shouldShowHero,
} from '../utils/posts';
import { buildSeo } from '../utils/seo';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: Post;
  /** Astro's `headings` array from `await render(post)`. */
  headings: MarkdownHeading[];
  /** Raw body string used for reading time. */
  body: string;
  prev?: Post;
  next?: Post;
  locale: Locale;
}

const { post, headings, body, prev, next, locale } = Astro.props;
const t = useTranslations(locale);
const minutes = readingTime(body).minutes;

/**
 * Resolve the source markdown file's filesystem path so we can read its
 * mtime for an auto-derived "Last updated" timestamp. Astro content
 * entries expose the source via `entry.filePath` (v5+) or, as a fallback,
 * we derive it from the entry id (`<locale>/<slug>` -> file path under
 * src/content/posts).
 */
const filePathCandidates: string[] = [];
const entryAny = post as unknown as { filePath?: string; id?: string };
if (entryAny.filePath) {
  filePathCandidates.push(entryAny.filePath);
}
if (entryAny.id) {
  // id format is "<locale>/<slug>" (e.g. "en/cse-03-shift-left-agentic")
  const idSlug = entryAny.id.split(/[\\/]/).slice(1).join('/') || entryAny.id;
  filePathCandidates.push(`src/content/posts/${entryAny.id}.md`);
  filePathCandidates.push(`src/content/posts/${entryAny.id}.mdx`);
  filePathCandidates.push(`src/content/posts/${idSlug}.md`);
  filePathCandidates.push(`src/content/posts/${idSlug}.mdx`);
}

let fileMtime: Date | null = null;
for (const candidate of filePathCandidates) {
  try {
    const { statSync } = await import('node:fs');
    const s = statSync(candidate);
    fileMtime = s.mtime;
    break;
  } catch {
    // try next candidate
  }
}

/**
 * Effective "updated" timestamp, in priority order:
 *   1. Explicit `updatedDate` frontmatter (author override)
 *   2. File mtime (auto-derived; updates on every build)
 *   3. `pubDate` (fallback so we always have a value)
 */
const effectiveUpdated: Date =
  post.data.updatedDate ?? fileMtime ?? post.data.pubDate;

// Translation siblings (used by language switcher links).
const translations = await getTranslations(post);
const translationLinks: Partial<Record<Locale, string>> = {};
for (const [lang, p] of Object.entries(translations)) {
  if (p) translationLinks[lang as Locale] = postPath(p);
}
// Locales that actually have a published version of this post.
const availableLocales = (Object.keys(translationLinks) as Locale[]).sort();

const commentsEnabled = post.data.comments !== false && GISCUS.enabled;
const pathWithoutLocale = stripLocale(Astro.url.pathname);

const heroSrc = heroImageSrc(post);
const heroAsset = heroImage(post);
const showHero = shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? '';

const articleClass = SITE.boxedArticles
  ? 'border-mtj-border bg-mtj-surface rounded-md border px-5 py-8 sm:px-8 sm:py-10'
  : 'px-1 py-6 sm:px-2 sm:py-8';

// Use hero image for OG if available, otherwise fallback to the generated OG image
// (unless Auto-OG is disabled globally or skipped in CI).
const ogSlug = postSlug(post);
const ogPrefix = locale === SITE.defaultLocale ? '' : `${locale}/`;
const generatedOgPath = `/og/${ogPrefix}${ogSlug}.png`;
const skipAutoOg = !SITE.autoOgImage || import.meta.env.CI_SKIP_AUTO_OG_IMAGE === 'true';
const ogImage = heroSrc ?? (skipAutoOg ? undefined : generatedOgPath);

const seo = buildSeo({
  title: post.data.title,
  description: post.data.description,
  pathWithoutLocale,
  fullPath: Astro.url.pathname,
  locale,
  ogImage,
  ogImageAlt: heroAlt || post.data.title,
  type: 'article',
  publishedTime: post.data.pubDate,
  modifiedTime: effectiveUpdated,
  tags: post.data.tags,
  availableLocales,
  // An unlisted post hides from SEO by default unless the author
  // explicitly sets `unlistedHideFromSeo: false`.
  noindex: post.data.unlisted && (post.data.unlistedHideFromSeo ?? true),
});

const crumbs = [
  { label: t('nav.posts'), href: localizedPath('/', locale) },
  { label: post.data.title },
];

let MathStylesComponent;
if (post.data.math) {
  MathStylesComponent = (await import('../components/seo/MathStyles.astro')).default;
}
// Only mount MermaidLoader on posts that contain ```mermaid fenced blocks.
// Auto-detection keeps authors from having to set a flag and ensures zero
// JS cost on posts that don't use diagrams.
const hasMermaid = body.includes('```mermaid');
---

<div class="reading-progress-bar" aria-hidden="true"></div>
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={effectiveUpdated}
  tags={post.data.tags}
  crumbs={crumbs}
  seo={seo}
  availableLocales={availableLocales}
>
  {post.data.math && MathStylesComponent && <MathStylesComponent />}
  {hasMermaid && <MermaidLoader />}
  {
    post.data.toc && headings.length > 0 && (
      <TableOfContents slot="aside-bottom" headings={headings} locale={locale} />
    )
  }

  <article class={articleClass}>

    {/* ── Hero image — full-bleed with gradient fade ───────────────────── */}
    {
      showHero && heroAsset && (
        <figure class="post-hero-banner" role="img" aria-label={heroAlt || post.data.title}>
          <div class="post-hero-banner__img-wrap">
            <SmartImage
              src={heroAsset}
              alt={heroAlt}
              class="post-hero-banner__img"
              loading="eager"
              widths={[480, 768, 1024, 1280, 1600]}
              sizes="(max-width: 768px) 100vw, 1024px"
              quality={85}
            />
            {/* Gradient overlay — top to transparent, bottom to page bg */}
            <div class="post-hero-banner__overlay" aria-hidden="true" />
          </div>
        </figure>
      )
    }

    {/* ── Article header ───────────────────────────────────────────────── */}
    <header class="post-article-header mb-10 mt-6">

      {/* Breadcrumb row: series + postType badge */}
      <div class="mb-3 flex flex-wrap items-center gap-2">
        {
          (post.data as any).postType && (
            <span
              class="post-type-badge"
              data-type={(post.data as any).postType}
            >
              <span class="post-type-dot" />
              {
                (post.data as any).postType === 'essay'        ? (locale === 'ms' ? 'Esei' : 'Essay') :
                (post.data as any).postType === 'case-study'   ? (locale === 'ms' ? 'Kajian Kes' : 'Case Study') :
                (post.data as any).postType === 'series-index' ? (locale === 'ms' ? 'Indeks Siri' : 'Series Index') :
                (post.data as any).postType === 'field-note'   ? (locale === 'ms' ? 'Nota Lapangan' : 'Field Note') : null
              }
            </span>
          )
        }
        {
          post.data.categories.map((c) => (
            <a
              href={categoryPath(locale, c)}
              class="text-mtj-text/50 hover:text-mtj-accent text-xs font-medium tracking-wide transition"
            >
              {c}
            </a>
          ))
        }
      </div>

      {/* Title — modern display type: clamp() keeps it responsive,
          line-height 1.1 with tight tracking -0.035em feels modern,
          and the gradient text uses the accent palette. */}
      <h1 class="post-title" style="font-size: clamp(1.75rem, 5vw, 2.6rem); line-height: 1.1; letter-spacing: -0.035em; font-weight: 700;">
        {post.data.title}
      </h1>

      {/* Description */}
      {
        post.data.description && (
          <p class="text-mtj-text/60 mt-4 text-lg leading-relaxed max-w-2xl">
            {post.data.description}
          </p>
        )
      }

      {/* Meta row */}
      <div class="post-meta-row mt-5 flex flex-wrap items-center gap-x-1 gap-y-2 text-sm">
        <span class="post-meta-chip">
          <Icon name="lucide:calendar-days" width={13} height={13} />
          <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate, locale)}</time>
        </span>
        <span class="post-meta-sep" aria-hidden="true">·</span>
        <span class="post-meta-chip">
          <Icon name="lucide:clock" width={13} height={13} />
          {minutes} {t('post.readingTime')}
        </span>
        {
          effectiveUpdated && (
            <>
              <span class="post-meta-sep" aria-hidden="true">·</span>
              <span class="post-meta-chip">
                <Icon name="lucide:pencil" width={13} height={13} />
                <time datetime={isoDate(effectiveUpdated)}>
                  {t('post.updatedOn')} {formatDate(effectiveUpdated, locale)}
                </time>
              </span>
            </>
          )
        }
      </div>

      {/* Divider */}
      <div class="post-header-rule mt-8" aria-hidden="true" />
    </header>

    <div class="prose-chirpy max-w-none">
      <slot />
    </div>

    {
      post.data.tags.length > 0 && (
        <footer class="border-mtj-border mt-10 flex flex-wrap items-center gap-2 border-t pt-6">
          <span class="text-mtj-text/70 text-sm font-semibold tracking-wide uppercase">
            {t('post.tags')}
          </span>
          {post.data.tags.map((tag) => (
            <a href={tagPath(locale, tag)} class="post-tag text-xs">
              {tag}
            </a>
          ))}
        </footer>
      )
    }

    <PostNav prev={prev} next={next} locale={locale} />

    {
      commentsEnabled ? (
        <Giscus locale={locale} />
      ) : (
        post.data.comments === false && (
          <p class="text-mtj-text/70 mt-10 text-sm">{t('post.commentsDisabled')}</p>
        )
      )
    }
  </article>
</BaseLayout>

{/* Translation links exposed for the LanguageSwitcher to read at runtime */}
<script is:inline define:vars={{ links: translationLinks }}>
  window.__chirpyTranslations = links;
</script>
