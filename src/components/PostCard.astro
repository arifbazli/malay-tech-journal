---
/**
 * PostCard — variant dispatcher.
 *
 * Delegates rendering to the appropriate sub-component based on `variant`.
 * Adding a new variant: create PostCard<Name>.astro and add a branch below.
 *
 * Variants:
 *   featured    — hero card: full-width, large image, oversized title
 *   grid        — 2-col grid: medium image, medium title
 *   compact     — text-only horizontal row
 *   series-card — series browser tile with article count
 *   default     — original horizontal Chirpy card (PostCardItem.astro)
 */
import { type Locale } from '../config';
import { type Post } from '../utils/posts';
import PostCardFeatured from './PostCardFeatured.astro';
import PostCardGrid from './PostCardGrid.astro';
import PostCardCompact from './PostCardCompact.astro';
import PostCardSeries from './PostCardSeries.astro';
import PostCardDefault from './PostCardDefault.astro';

interface Props {
  post: Post;
  locale: Locale;
  prioritizeLcp?: boolean;
  variant?: 'featured' | 'grid' | 'compact' | 'series-card' | 'default';
  seriesCount?: number;
}

const { post, locale, prioritizeLcp = false, variant = 'default', seriesCount } = Astro.props;
---

{
  variant === 'featured' && (
    <PostCardFeatured post={post} locale={locale} prioritizeLcp={prioritizeLcp} />
  )
}
{variant === 'grid' && <PostCardGrid post={post} locale={locale} />}
{variant === 'compact' && <PostCardCompact post={post} locale={locale} />}
{
  variant === 'series-card' && (
    <PostCardSeries post={post} locale={locale} seriesCount={seriesCount} />
  )
}
{
  (variant === 'default' || !variant) && (
    <PostCardDefault post={post} locale={locale} prioritizeLcp={prioritizeLcp} />
  )
}
