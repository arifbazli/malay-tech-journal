---
/**
 * Command palette (replaces search modal).
 * Sections:
 *   1. "Artikel Terkini" — most recent posts
 *   2. "Lompat Ke Siri" — quick links to series/category pages
 *   3. Free-text search (Pagefind backend, lazy-loaded)
 *
 * Trigger: "/" or Cmd/Ctrl+K
 * Keyboard: ↑↓ navigate · ↵ open · Esc close
 */
import { useTranslations, withBase, localizedPath } from '../../i18n/utils';
import type { Locale } from '../../config';
import { getArticles, getSeriesWithCount, categoryPath } from '../../utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const ms = locale === 'ms';
const pagefindScript = withBase('/_pagefind/pagefind.js');

const i18n = {
  placeholder: t('search.placeholder'),
  openLabel: t('search.openLabel'),
  closeLabel: t('search.closeLabel'),
  clearLabel: t('search.clearLabel'),
  typeToStart: t('search.typeToStart'),
  searching: t('search.searching'),
  noResultsFor: t('search.noResultsFor'),
  resultsCount: t('search.resultsCount'),
  resultsCountOne: t('search.resultsCountOne'),
};

// Recent articles (top 5)
const recent = (await getArticles(locale)).slice(0, 5);

// Series for "Lompat Ke Siri"
const series = await getSeriesWithCount(locale, 3);

function seriesDisplay(name: string): string {
  const s = name.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return ms ? 'Ground Truth' : 'Ground Truth';
  if (s.includes('guardrail')) return ms ? 'AI Guardrail Engineering' : 'AI Guardrail Engineering';
  if (s.includes('military') || s.includes('defence') || s.includes('defense')) return ms ? 'Military AI & Defence' : 'Military AI & Defence';
  if (s.includes('cloud') && s.includes('security')) return ms ? 'Cloud Security Engineering' : 'Cloud Security Engineering';
  return name;
}
function seriesPillMiniClass(name: string): string {
  const s = name.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return 'pill-mini--ground';
  if (s.includes('guardrail')) return 'pill-mini--ai';
  if (s.includes('military') || s.includes('defence') || s.includes('defense')) return 'pill-mini--mil';
  return 'pill-mini--ai';
}
function getSeries(post: any): string {
  return (post.data.categories as string[])[0] ?? '';
}
function postHref(post: any): string {
  return localizedPath(`/posts/${post.id.split('/').pop()}/`, locale);
}
---

<button
  type="button"
  class="search-pill"
  aria-label={i18n.openLabel}
  title={i18n.openLabel}
  data-cmdk-open
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"/>
    <path d="m21 21-4.35-4.35"/>
  </svg>
  <span class="search-pill__label">{ms ? 'Cari' : 'Search'}</span>
  {/* FIX (2026-07-22): platform-aware keyboard hint.
       - Shows ⌘K on Mac, Ctrl K on Windows/Linux — the more powerful
         shortcut that 99% of power users actually use.
       - Slash fallback kept as a secondary badge for muscle memory.
       - Icons rendered via <kbd data-kbd-mod> by platform-detection script
         below; the static / is shown if JS is disabled. */}
  <kbd class="search-pill__kbd search-pill__kbd--primary" data-kbd-mod aria-hidden="true">⌘K</kbd>
  <kbd class="search-pill__kbd search-pill__kbd--slash" aria-hidden="true">/</kbd>
</button>

<div
  class="mtj-cmdk"
  data-cmdk
  data-i18n={JSON.stringify(i18n)}
  data-pagefind-script={pagefindScript}
  role="dialog"
  aria-modal="true"
  aria-label={i18n.openLabel}
>
  <div class="mtj-cmdk__modal">
    {/* Search input row */}
    <div class="mtj-cmdk__row">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.35-4.35"/>
      </svg>
      <input
        type="search"
        data-cmdk-input
        class="mtj-cmdk__input"
        placeholder={i18n.placeholder}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label={i18n.openLabel}
      />
      <span class="mtj-cmdk__esc">ESC</span>
    </div>

    {/* Body */}
    <div data-cmdk-body class="mtj-cmdk__body">

      {/* Artikel Terkini (default state, hidden when typing) */}
      <div data-cmdk-section="recent">
        <div class="mtj-cmdk__group">{ms ? 'Artikel Terkini' : 'Recent Articles'}</div>
        {
          recent.map((post) => (
            <a href={postHref(post)} class="mtj-cmdk__item" data-cmdk-item>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
              <span class="label">{post.data.title}</span>
              <span class="meta">
                <span class={`pill-mini ${seriesPillMiniClass(getSeries(post))}`}>
                  {seriesDisplay(getSeries(post))}
                </span>
              </span>
            </a>
          ))
        }

        {/* Lompat Ke Siri */}
        <div class="mtj-cmdk__group" style="margin-top: 0.5rem">{ms ? 'Lompat Ke Siri' : 'Jump To Series'}</div>
        {
          series.map((s) => (
            <a href={categoryPath(locale, s.name)} class="mtj-cmdk__item" data-cmdk-item>
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
              <span class="label">{seriesDisplay(s.name)}</span>
              <span class="meta">
                <span class={`pill-mini ${seriesPillMiniClass(s.name)}`}>
                  {s.count} {ms ? 'artikel' : 'posts'}
                </span>
              </span>
            </a>
          ))
        }
      </div>

      {/* Search results (shown when typing) */}
      <div data-cmdk-section="results" hidden>
        <div data-cmdk-results></div>
      </div>
    </div>

    {/* Footer hint */}
    <div class="mtj-cmdk__hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> {ms ? 'navigasi' : 'navigate'}</span>
      <span><kbd>↵</kbd> {ms ? 'buka' : 'open'}</span>
      <span><kbd>Esc</kbd> {ms ? 'tutup' : 'close'}</span>
    </div>
  </div>
</div>

<script>
  interface PagefindSearchData {
    url: string;
    excerpt?: string;
    meta?: { title?: string };
  }
  interface PagefindResult {
    data: () => Promise<PagefindSearchData>;
  }
  interface PagefindModule {
    init?: () => Promise<void>;
    search: (_term: string) => Promise<{ results: PagefindResult[] } | null>;
  }

  let pagefindModule: PagefindModule | null = null;
  let loadPromise: Promise<PagefindModule> | null = null;
  let searchToken = 0;
  let highlightIdx = -1;
  let resultLinks: HTMLElement[] = [];
  let debounceTimer: ReturnType<typeof setTimeout> | undefined;
  let PAGEFIND_SCRIPT: string | undefined;
  let I18N: Record<string, string> = {};

  function loadPagefind() {
    if (pagefindModule) return Promise.resolve(pagefindModule);
    if (loadPromise) return loadPromise;
    loadPromise = import(/* @vite-ignore */ PAGEFIND_SCRIPT as string)
      .then(async (mod) => {
        if (typeof mod.init === 'function') await mod.init();
        pagefindModule = mod;
        return mod;
      })
      .catch((err) => {
        console.error('Failed to load Pagefind', err);
        loadPromise = null;
        throw err;
      });
    return loadPromise;
  }

  function escapeHtml(s: string) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function sanitizeExcerpt(html: string) {
    const escaped = escapeHtml(html ?? '');
    return escaped.replaceAll('&lt;mark&gt;', '<mark>').replaceAll('&lt;/mark&gt;', '</mark>');
  }

  function getVisibleItems(): HTMLElement[] {
    const modal = document.querySelector<HTMLElement>('[data-cmdk]');
    if (!modal) return [];
    return Array.from(modal.querySelectorAll<HTMLElement>('[data-cmdk-item]:not([hidden])'));
  }

  function updateHighlight() {
    resultLinks = getVisibleItems();
    resultLinks.forEach((link, i) => {
      if (i === highlightIdx) {
        link.classList.add('is-sel');
        link.scrollIntoView({ block: 'nearest' });
      } else {
        link.classList.remove('is-sel');
      }
    });
  }

  function moveHighlight(delta: number) {
    const items = getVisibleItems();
    if (items.length === 0) return;
    highlightIdx = (highlightIdx + delta + items.length) % items.length;
    updateHighlight();
  }

  function activateHighlight() {
    const items = getVisibleItems();
    if (highlightIdx < 0 || !items[highlightIdx]) return false;
    const href = items[highlightIdx].getAttribute('href');
    if (href) {
      window.location.href = href;
      return true;
    }
    return false;
  }

  function init() {
    const overlay = document.querySelector<HTMLElement>('[data-cmdk]');
    const input = document.querySelector<HTMLInputElement>('[data-cmdk-input]');
    const body = document.querySelector<HTMLElement>('[data-cmdk-body]');
    if (!overlay || !input || !body) return;

    PAGEFIND_SCRIPT = overlay.dataset.pagefindScript;
    I18N = JSON.parse(overlay.dataset.i18n || '{}');

    const recentSection = overlay.querySelector<HTMLElement>('[data-cmdk-section="recent"]');
    const resultsSection = overlay.querySelector<HTMLElement>('[data-cmdk-section="results"]');
    const resultsContainer = overlay.querySelector<HTMLElement>('[data-cmdk-results]');

    function reset() {
      input!.value = '';
      if (recentSection) recentSection.hidden = false;
      if (resultsSection) resultsSection.hidden = true;
      if (resultsContainer) resultsContainer.innerHTML = '';
      highlightIdx = -1;
      updateHighlight();
    }

    function open() {
      overlay!.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        input!.focus();
        highlightIdx = 0;
        updateHighlight();
      });
      loadPagefind().catch(() => {});
    }

    function close() {
      overlay!.classList.remove('is-open');
      document.body.style.overflow = '';
      reset();
    }

    async function runSearch(term: string) {
      const myToken = ++searchToken;
      try {
        const pf = await loadPagefind();
        if (myToken !== searchToken) return;
        const search = await pf.search(term);
        if (myToken !== searchToken) return;
        if (!search || !search.results || search.results.length === 0) {
          if (resultsContainer) {
            resultsContainer.innerHTML = `<div style="padding: 2rem 1rem; text-align: center; color: var(--mtj-muted); font-size: 0.875rem;">${escapeHtml(I18N.noResultsFor)} "<strong>${escapeHtml(term)}</strong>"</div>`;
          }
          return;
        }
        const top = search.results.slice(0, 12);
        const data = await Promise.all(top.map((r) => r.data()));
        if (myToken !== searchToken) return;
        renderResults(data);
      } catch (err) {
        console.error(err);
      }
    }

    function renderResults(results: PagefindSearchData[]) {
      if (!resultsContainer) return;
      const items = results
        .map((r) => {
          const title = escapeHtml(r.meta?.title || r.url);
          const excerpt = sanitizeExcerpt(r.excerpt || '');
          return `<a href="${escapeHtml(r.url)}" class="mtj-cmdk__item" data-cmdk-item>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <span class="label">${title}</span>
          </a>
          <div style="padding: 0 1rem 0.5rem 2.5rem; font-size: 0.72rem; color: var(--mtj-muted); line-height: 1.4;">${excerpt}</div>`;
        })
        .join('');
      resultsContainer.innerHTML = items;
      highlightIdx = 0;
      updateHighlight();
    }

    function onInput() {
      const term = input!.value.trim();
      if (term) {
        if (recentSection) recentSection.hidden = true;
        if (resultsSection) resultsSection.hidden = false;
        if (resultsContainer) {
          resultsContainer.innerHTML = `<div style="padding: 1.5rem 1rem; text-align: center; color: var(--mtj-muted); font-size: 0.875rem;">${escapeHtml(I18N.searching)}</div>`;
        }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runSearch(term), 140);
      } else {
        if (recentSection) recentSection.hidden = false;
        if (resultsSection) resultsSection.hidden = true;
        if (resultsContainer) resultsContainer.innerHTML = '';
        highlightIdx = 0;
        updateHighlight();
      }
    }

    input.addEventListener('input', onInput);

    // Click outside closes
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // Keyboard nav
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        moveHighlight(1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        moveHighlight(-1);
      } else if (e.key === 'Enter') {
        if (activateHighlight()) e.preventDefault();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    // Open triggers
    document.querySelectorAll('[data-cmdk-open]').forEach((btn) => {
      btn.addEventListener('click', open);
    });

    function isTypingTarget(target: EventTarget | null) {
      if (!(target instanceof HTMLElement)) return false;
      if (target.isContentEditable) return true;
      const tag = target.tagName;
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
    }

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      const isSlash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !isTypingTarget(e.target);
      if (isCmdK || isSlash) {
        e.preventDefault();
        open();
      } else if (e.key === 'Escape' && overlay.classList.contains('is-open')) {
        close();
      }
    });
  }

  init();
  document.addEventListener('DOMContentLoaded', init);

  // Platform-aware keyboard badge: ⌘K on Mac, Ctrl K elsewhere.
  // Runs once at module load — no need to wait for DOMContentLoaded, since
  // the badges are guaranteed to be in the DOM by the time this runs (the
  // script is at the end of the SearchButton.astro island).
  (function setPlatformKbd() {
    const mod = document.querySelector<HTMLElement>('[data-kbd-mod]');
    if (!mod) return;
    const ua = navigator.userAgent || '';
    const isMac = /mac/i.test(navigator.platform) || /mac/i.test(ua);
    mod.textContent = isMac ? '⌘K' : 'Ctrl K';
    // Update the search-pill title attribute so the native tooltip shows
    // the correct shortcut for the user's platform.
    const pill = mod.closest<HTMLElement>('.search-pill');
    if (pill) {
      const label = pill.getAttribute('aria-label') || 'Search';
      pill.setAttribute('title', `${label} (${isMac ? '⌘K' : 'Ctrl K'} or /)`);
    }
  })();
</script>
