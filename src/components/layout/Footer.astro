---
import { Icon } from 'astro-icon/components';
import { REPO, SITE, SOCIALS, type Locale } from '../../config';
import { localizedPath, useTranslations } from '../../i18n/utils';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
// Built as one string: splitting `© {year}` and `{SITE.title}` across lines
// (which Prettier does for long JSX) made Astro drop the space between them.
const copyright = `© ${year} ${SITE.title}`;
const t = useTranslations(locale);

// Social links come from SOCIALS (src/config.ts) so the footer, SEO and
// any other surface always point at the same profile. GitHub uses the
// same PUBLIC_GITHUB_HANDLE as REPO.url; RSS follows the active locale.
const links = [
  ...SOCIALS.map((s) => ({ ...s, external: !s.href.startsWith('mailto:') })),
  ...(REPO.handle
    ? [
        {
          label: 'GitHub',
          href: `https://github.com/${REPO.handle}`,
          icon: 'simple-icons:github',
          external: true,
        },
      ]
    : []),
  {
    label: t('footer.rss'),
    href: localizedPath('/rss.xml', locale),
    icon: 'lucide:rss',
    external: false,
  },
];
---

<footer aria-label="Site Info" class="mtj-footer">
  <div class="mtj-footer__inner">
    <div class="mtj-footer__brand">
      <Logo size={24} strokeWidth={3} />
      <span class="mtj-footer__copy">{copyright}</span>
    </div>
    <span class="mtj-footer__sep" aria-hidden="true"></span>
    <ul class="mtj-footer__links" aria-label="Footer">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="mtj-footer__link"
            rel={link.external ? 'noopener me' : undefined}
            target={link.external ? '_blank' : undefined}
          >
            <Icon name={link.icon} width={14} height={14} aria-hidden="true" />
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
