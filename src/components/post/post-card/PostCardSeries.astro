---
import { type Locale } from '../../../config';
import { type Post, postPath, heroImage, shouldShowHero } from '../../../utils/posts';
import SmartImage from '../../ui/SmartImage.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  post: Post;
  locale: Locale;
  /** Number of articles in this series. */
  seriesCount?: number;
}

const { post, locale, seriesCount } = Astro.props;
const href = postPath(post);
const heroAsset = heroImage(post);
const hasImage = Boolean(heroAsset) && shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? '';
---

<article class="series-tile">
  <a href={href} class="series-tile__link">
    {
      hasImage && (
        <div class="series-tile__img-wrap">
          <SmartImage
            src={heroAsset!}
            alt={heroAlt}
            class="series-tile__img"
            loading="lazy"
            widths={[400, 800]}
            sizes="(max-width: 640px) 100vw, 50vw"
            quality={70}
          />
          <div class="series-tile__img-overlay" />
        </div>
      )
    }
    <div class="series-tile__body">
      {
        post.data.categories[0] && (
          <span class="eyebrow-label">{locale === 'ms' ? 'Siri' : 'Series'}</span>
        )
      }
      <h2 class="series-tile__title">{post.data.title}</h2>
      {post.data.description && <p class="series-tile__desc">{post.data.description}</p>}
      <div class="series-tile__footer">
        {
          seriesCount != null && (
            <span class="series-tile__count">
              <Icon name="lucide:file-text" width={12} height={12} />
              {seriesCount} {locale === 'ms' ? 'catatan' : 'posts'}
            </span>
          )
        }
        <span class="series-tile__cta">
          {locale === 'ms' ? 'Lihat siri' : 'View series'}
          <Icon name="lucide:arrow-right" width={12} height={12} />
        </span>
      </div>
    </div>
  </a>
</article>
