---
/**
 * PostCardItem — single article row (mtj-card).
 *
 * Shared by PostList.astro (main feed) and Panel.astro (sidebar
 * "Recently Updated"). The `compact` flag drops the day/month column and
 * adds `.mtj-card--compact` so the body uses the full rail width.
 *
 * Series/type labels and colours come from `utils/taxonomy.ts` so every
 * listing surface renders the same names.
 */
import type { Locale } from '../../../config';
import { isoDate, localizedPath } from '../../../i18n/utils';
import { readingTime } from '../../../utils/reading-time';
import type { Post } from '../../../utils/posts';
import { postSeries, postTypeLabel, readTimeLabel, seriesInfo } from '../../../utils/taxonomy';

interface Props {
  post: Post;
  locale: Locale;
  /** When true, drop the day/month column (used in narrow sidebar) */
  compact?: boolean;
  /** Heading level for the title (lists under an h2 should use h3). */
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { post, locale, compact = false, headingLevel = 'h3' } = Astro.props;
const ms = locale === 'ms';
const Heading = headingLevel;

const dayFmt = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { day: '2-digit' });
const monShort = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { month: 'short' });

const href = localizedPath(`/posts/${post.id.split('/').pop()}/`, locale);
const seriesName = postSeries(post);
const series = seriesName ? seriesInfo(seriesName) : undefined;
const type = postTypeLabel(post.data.postType, locale);
const minutes = readingTime((post as { body?: string }).body ?? '').minutes;
const day = dayFmt.format(post.data.pubDate);
const mon = monShort.format(post.data.pubDate);
---

<li class:list={['mtj-card', compact && 'mtj-card--compact']}>
  <a href={href} class="mtj-card__link">
    {
      !compact && (
        <time class="mtj-card__date" datetime={isoDate(post.data.pubDate)}>
          <span class="mtj-card__day">{day}</span>
          <span class="mtj-card__mon">{mon}</span>
        </time>
      )
    }
    <div class="mtj-card__body">
      <div class="mtj-card__meta">
        {series && <span class={`mtj-pill mtj-pill--${series.tone}`}>{series.short}</span>}
        {type && <span class="mtj-card__type">{type}</span>}
      </div>
      <Heading class="mtj-card__title">{post.data.title}</Heading>
      {post.data.description && <p class="mtj-card__desc">{post.data.description}</p>}
      <div class="mtj-card__read">{readTimeLabel(minutes, locale)}</div>
    </div>
  </a>
</li>
