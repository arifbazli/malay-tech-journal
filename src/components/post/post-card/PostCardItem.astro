---
/**
 * PostCardItem — single article row (mtj-card).
 *
 * Shared component used by:
 *   - src/components/PostList.astro (main feed)
 *   - src/components/Panel.astro    (sidebar "Recently Updated" / "Kemaskini Terkini")
 *
 * Both call sites use the EXACT SAME markup and classes, so typography
 * (title, type, description, read-time) is identical across the main
 * feed and the sidebar widget. The `compact` flag drops the day/month
 * column AND adds the .mtj-card--compact class so the grid reclaims
 * the 44px column (otherwise it would render as a 44px empty cell and
 * squeeze the body to ~215px in a 260px sidebar).
 */
import type { Locale } from '../../../config';
import { localizedPath } from '../../../i18n/utils';
import { readingTime } from '../../../utils/reading-time';
import type { Post } from '../../../utils/posts';

interface Props {
  post: Post;
  locale: Locale;
  /** When true, drop the day/month column (used in narrow sidebar) */
  compact?: boolean;
}

const { post, locale, compact = false } = Astro.props;
const ms = locale === 'ms';

const dayFmt = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { day: '2-digit' });
const monShort = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { month: 'short' });

function typeLabel(type: string | undefined): string {
  if (!type) return '';
  if (type === 'essay') return ms ? 'Esei' : 'Essay';
  if (type === 'case-study') return ms ? 'Kajian Kes' : 'Case Study';
  if (type === 'field-note') return ms ? 'Nota' : 'Field Note';
  if (type === 'series-index') return '';
  return type;
}

function seriesPillClass(series: string): string {
  const s = series.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return 'mtj-pill--ground';
  if (s.includes('guardrail')) return 'mtj-pill--ai';
  if (s.includes('military') || s.includes('defence') || s.includes('defense'))
    return 'mtj-pill--mil';
  if (s.includes('cloud') && s.includes('security')) return 'mtj-pill--ground';
  return 'mtj-pill--ai';
}

function seriesDisplayName(series: string): string {
  const s = series.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return ms ? 'Ground Truth' : 'Ground Truth';
  if (s.includes('guardrail')) return ms ? 'AI Guardrail' : 'AI Guardrail';
  if (s.includes('military') || s.includes('defence') || s.includes('defense'))
    return ms ? 'Military AI' : 'Military AI';
  if (s.includes('cloud') && s.includes('security')) return ms ? 'Cloud Sec' : 'Cloud Sec';
  return series;
}

function readTime(post: Post): string {
  const body = (post as { body?: string }).body ?? '';
  const mins = readingTime(body).minutes;
  return ms ? `${mins} min baca` : `${mins} min read`;
}

function postHref(post: Post, locale: Locale): string {
  return localizedPath(`/posts/${post.id.split('/').pop()}/`, locale);
}

const series = ((post.data.categories as string[]) ?? [])[0] ?? '';
const type = post.data.postType as string | undefined;
const day = dayFmt.format(post.data.pubDate);
const mon = monShort.format(post.data.pubDate);
---

<li class:list={['mtj-card', compact && 'mtj-card--compact']}>
  <a href={postHref(post, locale)} class="mtj-card__link">
    {
      !compact && (
        <div class="mtj-card__date">
          <span class="mtj-card__day">{day}</span>
          <span class="mtj-card__mon">{mon}</span>
        </div>
      )
    }
    <div class="mtj-card__body">
      <div class="mtj-card__meta">
        {
          series && (
            <span class={`mtj-pill ${seriesPillClass(series)}`} style="margin-bottom:0">
              {seriesDisplayName(series)}
            </span>
          )
        }
        {type && type !== 'series-index' && <span class="mtj-card__type">{typeLabel(type)}</span>}
      </div>
      <div class="mtj-card__title">{post.data.title}</div>
      {post.data.description && <div class="mtj-card__desc">{post.data.description}</div>}
      <div class="mtj-card__read">{readTime(post)}</div>
    </div>
  </a>
</li>
