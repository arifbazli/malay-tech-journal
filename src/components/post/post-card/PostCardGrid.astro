---
import { type Locale } from '../../../config';
import { formatDate, isoDate } from '../../../i18n/utils';
import { type Post, postPath, heroImage, shouldShowHero } from '../../../utils/posts';
import SmartImage from '../../ui/SmartImage.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const href = postPath(post);
const heroAsset = heroImage(post);
const hasImage = Boolean(heroAsset) && shouldShowHero(post);
const heroAlt = post.data.heroImageAlt ?? '';

const postType = (post.data as any).postType as string | undefined;
const postTypeLabel =
  postType === 'essay'
    ? locale === 'ms'
      ? 'Esei'
      : 'Essay'
    : postType === 'case-study'
      ? locale === 'ms'
        ? 'Kajian Kes'
        : 'Case Study'
      : postType === 'series-index'
        ? locale === 'ms'
          ? 'Siri'
          : 'Series'
        : postType === 'field-note'
          ? locale === 'ms'
            ? 'Nota Lapangan'
            : 'Field Note'
          : undefined;

const dateStr = formatDate(post.data.pubDate, locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="bento-grid-card">
  <a href={href} class="bento-grid-card__link">
    {
      hasImage && (
        <div class="bento-grid-card__img-wrap">
          <SmartImage
            src={heroAsset!}
            alt={heroAlt}
            class="bento-grid-card__img"
            loading="lazy"
            widths={[400, 800]}
            sizes="(max-width: 767px) 100vw, 50vw"
            quality={75}
          />
        </div>
      )
    }
    <div class="bento-grid-card__body">
      {
        postType && postTypeLabel && (
          <span class="post-type-badge" data-type={postType}>
            <span class="post-type-dot" />
            {postTypeLabel}
          </span>
        )
      }
      <h2 class="bento-grid-card__title">{post.data.title}</h2>
      {post.data.description && <p class="bento-grid-card__desc">{post.data.description}</p>}
      <div class="bento-grid-card__meta">
        <Icon name="lucide:calendar" width={11} height={11} />
        <time datetime={isoDate(post.data.pubDate)}>{dateStr}</time>
        {
          post.data.categories[0] && (
            <>
              <span class="opacity-30">·</span>
              <span>{post.data.categories[0]}</span>
            </>
          )
        }
      </div>
    </div>
  </a>
</article>
