---
/**
 * Projects page — BM + EN, handled from a single file.
 * Route: /projects (MS default) and /en/projects (EN)
 *
 * Simple static list of current GitHub projects (name, one-line summary,
 * primary language, link) plus a link to the full repositories tab.
 * No live GitHub API calls at build time — see AGENTS.md for why that
 * was removed.
 */
import { SITE, type Locale } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const isBM = locale === 'ms';

interface Project {
  name: string;
  url: string;
  language: string;
  description: string;
}

const GITHUB_HANDLE = 'arifbazli';
const githubAllUrl = `https://github.com/${GITHUB_HANDLE}?tab=repositories`;

const projects: Project[] = isBM
  ? [
      {
        name: 'malay-tech-journal',
        url: `https://github.com/${GITHUB_HANDLE}/malay-tech-journal`,
        language: 'Astro',
        description: 'Blog ini — penyelidikan & pembangunan agent harness tempatan.',
      },
      {
        name: 'AI-Agent-Guardrails-Hub',
        url: `https://github.com/${GITHUB_HANDLE}/AI-Agent-Guardrails-Hub`,
        language: 'Open Policy Agent',
        description: 'Hab guardrail multi-ejen yang menyembuh sendiri (self-healing).',
      },
      {
        name: 'cyber-pujangga',
        url: `https://github.com/${GITHUB_HANDLE}/cyber-pujangga`,
        language: 'Astro',
        description: 'Penyelidikan & pembangunan agent harness tempatan.',
      },
      {
        name: 'deliverableqa-agent',
        url: `https://github.com/${GITHUB_HANDLE}/deliverableqa-agent`,
        language: 'Python',
        description: 'Ejen QA deliverable menggunakan AWS Bedrock Claude.',
      },
      {
        name: 'GuardAgent_PenTest_Guardrail',
        url: `https://github.com/${GITHUB_HANDLE}/GuardAgent_PenTest_Guardrail`,
        language: 'Python',
        description: 'GuardAgent PenTest — ujian guardrail untuk ejen coding AI.',
      },
      {
        name: 'rust-agentic-sandbox',
        url: `https://github.com/${GITHUB_HANDLE}/rust-agentic-sandbox`,
        language: 'Rust',
        description: 'Orkestrator ejen Rust (CLI — pipeline gateway harness).',
      },
      {
        name: 'Semantic-review-cli-local-mcp',
        url: `https://github.com/${GITHUB_HANDLE}/Semantic-review-cli-local-mcp`,
        language: 'TypeScript',
        description:
          'Carian kod semantik agnostik-ejen (CLI + pelayan MCP tempatan) — embedding Ollama tempatan + penjejakan call-graph AST tree-sitter.',
      },
      {
        name: 'shift-left-cloud-sandbox',
        url: `https://github.com/${GITHUB_HANDLE}/shift-left-cloud-sandbox`,
        language: 'Shell',
        description: 'Sandbox keselamatan cloud shift-left.',
      },
    ]
  : [
      {
        name: 'malay-tech-journal',
        url: `https://github.com/${GITHUB_HANDLE}/malay-tech-journal`,
        language: 'Astro',
        description: 'This blog — local agent harness research and development.',
      },
      {
        name: 'AI-Agent-Guardrails-Hub',
        url: `https://github.com/${GITHUB_HANDLE}/AI-Agent-Guardrails-Hub`,
        language: 'Open Policy Agent',
        description: 'Self-healing multi-agent guardrail hub.',
      },
      {
        name: 'cyber-pujangga',
        url: `https://github.com/${GITHUB_HANDLE}/cyber-pujangga`,
        language: 'Astro',
        description: 'Local agent harness research and development.',
      },
      {
        name: 'deliverableqa-agent',
        url: `https://github.com/${GITHUB_HANDLE}/deliverableqa-agent`,
        language: 'Python',
        description: 'AWS Bedrock Claude — deliverable QA agents.',
      },
      {
        name: 'GuardAgent_PenTest_Guardrail',
        url: `https://github.com/${GITHUB_HANDLE}/GuardAgent_PenTest_Guardrail`,
        language: 'Python',
        description: 'GuardAgent PenTest — guardrail testing for AI coding agents.',
      },
      {
        name: 'rust-agentic-sandbox',
        url: `https://github.com/${GITHUB_HANDLE}/rust-agentic-sandbox`,
        language: 'Rust',
        description: 'Rust agent orchestrator (CLI — Harness gateway pipeline).',
      },
      {
        name: 'Semantic-review-cli-local-mcp',
        url: `https://github.com/${GITHUB_HANDLE}/Semantic-review-cli-local-mcp`,
        language: 'TypeScript',
        description:
          'Agent-agnostic semantic code search (CLI + local MCP server) — local Ollama embeddings + tree-sitter AST call-graph tracing.',
      },
      {
        name: 'shift-left-cloud-sandbox',
        url: `https://github.com/${GITHUB_HANDLE}/shift-left-cloud-sandbox`,
        language: 'Shell',
        description: 'Shift-left cloud security sandbox.',
      },
    ];
---

<BaseLayout
  title={t('projects.title')}
  description={t('projects.subtitle')}
  pathWithoutLocale="/projects"
  narrow
>
  <article class="proj">
    <header class="proj__head">
      <p class="proj__eyebrow">{t('projects.eyebrow')}</p>
      <h1 class="proj__title">{t('projects.title')}</h1>
      <p class="proj__subtitle">{t('projects.subtitle')}</p>
    </header>

    <ul class="proj__list">
      {
        projects.map((p) => (
          <li class="proj__item">
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="proj__link">
              <div class="proj__item-head">
                <span class="proj__item-name">{p.name}</span>
                <Icon name="lucide:arrow-up-right" width={13} height={13} class="proj__item-icon" />
              </div>
              <p class="proj__item-desc">{p.description}</p>
              <span class="proj__item-lang">{p.language}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <a href={githubAllUrl} target="_blank" rel="noopener noreferrer" class="proj__all">
      {t('projects.viewAll')}
      <Icon name="lucide:arrow-up-right" width={14} height={14} />
    </a>
  </article>
</BaseLayout>

<style>
  .proj {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .proj__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .proj__eyebrow {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mtj-accent);
    font-weight: 700;
  }
  .proj__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--mtj-text);
  }
  .proj__subtitle {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--mtj-muted);
    max-width: 60ch;
  }

  .proj__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  @media (max-width: 640px) {
    .proj__list {
      grid-template-columns: 1fr;
    }
  }

  .proj__item {
    min-width: 0;
  }
  .proj__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 0.75rem 0.9rem;
    background: var(--mtj-surface);
    border: 0.5px solid var(--mtj-muted);
    border-radius: 8px;
    text-decoration: none;
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .proj__link:hover {
    border-color: var(--mtj-accent);
    background: var(--mtj-surface-2);
  }

  .proj__item-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .proj__item-name {
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mtj-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .proj__item-icon {
    flex-shrink: 0;
    color: var(--mtj-muted);
  }
  .proj__link:hover .proj__item-icon {
    color: var(--mtj-accent);
  }

  .proj__item-desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--mtj-muted);
  }

  .proj__item-lang {
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--mtj-accent);
  }

  .proj__all {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.9rem;
    border-radius: 7px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--mtj-bg);
    background: var(--mtj-accent);
    text-decoration: none;
    transition: filter 120ms ease;
  }
  .proj__all:hover {
    filter: brightness(1.12);
  }
</style>
