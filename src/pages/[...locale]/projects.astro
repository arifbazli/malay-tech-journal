---
/**
 * Projects page — BM + EN, handled from a single file.
 * Route: /projects (MS default) and /en/projects (EN)
 *
 * The list is built from the owner's public GitHub repositories at build
 * time (src/utils/github-projects.ts), so new repositories, renames,
 * languages and activity dates update on every deploy. The deploy workflow
 * also rebuilds daily. Curated outcome lines live in PROJECT_HIGHLIGHTS.
 */
import { REPO, SITE, type Locale } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { buildProjects, fetchRepositories } from '~/utils/github-projects';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const owner = REPO.handle || 'arifbazli';
const githubAllUrl = `https://github.com/${owner}?tab=repositories`;
const projects = buildProjects(await fetchRepositories(owner), owner, locale);

const monthFmt = new Intl.DateTimeFormat(locale === 'ms' ? 'ms-MY' : 'en-GB', {
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title={t('projects.title')}
  description={t('projects.subtitle')}
  pathWithoutLocale="/projects/"
  narrow
>
  <article class="proj">
    <header class="proj__head">
      <p class="proj__eyebrow">{t('projects.eyebrow')}</p>
      <h1 class="proj__title">{t('projects.title')}</h1>
      <p class="proj__subtitle">{t('projects.subtitle')}</p>
    </header>

    <ul class="proj__list">
      {projects.map((p) => (
        <li class="proj__item">
          <div class="proj__card">
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="proj__link">
              <span class="proj__item-name">{p.name}</span>
              <Icon
                name="lucide:arrow-up-right"
                width={13}
                height={13}
                class="proj__item-icon"
                aria-hidden="true"
              />
            </a>
            {p.summary && <p class="proj__item-desc">{p.summary}</p>}
            <div class="proj__item-meta">
              {p.language && <span class="proj__item-lang">{p.language}</span>}
              {p.pushedAt && (
                <span class="proj__item-date">
                  {t('projects.updated')}{' '}
                  <time datetime={p.pushedAt.toISOString()}>{monthFmt.format(p.pushedAt)}</time>
                </span>
              )}
              {p.homepage && (
                <a
                  href={p.homepage}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="proj__item-live"
                >
                  {t('projects.live')}
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <a href={githubAllUrl} target="_blank" rel="noopener noreferrer" class="proj__all">
      {t('projects.viewAll')}
      <Icon name="lucide:arrow-up-right" width={14} height={14} />
    </a>
  </article>
</BaseLayout>

<style>
  .proj {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .proj__head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .proj__eyebrow {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mtj-accent);
    font-weight: 700;
  }
  .proj__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--mtj-text);
  }
  .proj__subtitle {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--mtj-muted);
    max-width: 60ch;
  }

  .proj__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  @media (max-width: 640px) {
    .proj__list {
      grid-template-columns: 1fr;
    }
  }

  .proj__item {
    min-width: 0;
  }
  .proj__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 0.75rem 0.9rem;
    background: var(--mtj-surface);
    border: 0.5px solid var(--mtj-muted);
    border-radius: 8px;
    transition:
      border-color 120ms ease,
      background 120ms ease;
  }
  .proj__card:hover,
  .proj__card:focus-within {
    border-color: var(--mtj-accent);
    background: var(--mtj-surface-2);
  }

  /* Whole card is clickable through the name link's stretched ::after. */
  .proj__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    text-decoration: none;
  }
  .proj__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
  }
  .proj__item-name {
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mtj-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .proj__item-icon {
    flex-shrink: 0;
    color: var(--mtj-muted);
  }
  .proj__card:hover .proj__item-icon {
    color: var(--mtj-accent);
  }

  .proj__item-desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--mtj-muted);
  }

  .proj__item-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.8rem;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }
  .proj__item-lang {
    color: var(--mtj-accent);
  }
  .proj__item-date {
    color: var(--mtj-muted);
  }
  .proj__item-live {
    position: relative;
    z-index: 1;
    color: var(--mtj-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .proj__all {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.5rem 0.9rem;
    border-radius: 7px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--mtj-bg);
    background: var(--mtj-accent);
    text-decoration: none;
    transition: filter 120ms ease;
  }
  .proj__all:hover {
    filter: brightness(1.12);
  }
</style>
