---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '../../components/post/PostList.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { readingTime } from '~/utils/reading-time';
import { SITE } from '~/config';
import { localizedPath, useTranslations } from '~/i18n/utils';
import { getArticles } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const ms = locale === 'ms';

const articles = await getArticles(locale);
const pageSize = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(articles.length / pageSize));
const pagePosts = articles.slice(0, pageSize);

// ── Bento selection (homepage only): top 4 posts by reading time
const bentoPosts = pagePosts.slice(0, 4);
const bentoLong  = bentoPosts[0];
const bentoMid   = bentoPosts[1];
const bentoSmall1 = bentoPosts[2];
const bentoSmall2 = bentoPosts[3];
const remainingPosts = pagePosts.slice(4);

// ── Bento helpers (kept inline; the bento is homepage-only decoration) ──
function readTime(post: any): number {
  const body = (post as { body?: string }).body ?? '';
  return readingTime(body).minutes;
}
function readTimeLabel(post: any): string {
  const m = readTime(post);
  return ms ? `${m} min baca` : `${m} min read`;
}
function typeLabel(type: string | undefined): string {
  if (!type) return '';
  if (type === 'essay')       return ms ? 'Esei'       : 'Essay';
  if (type === 'case-study')  return ms ? 'Kajian Kes' : 'Case Study';
  if (type === 'field-note')  return ms ? 'Nota'       : 'Field Note';
  if (type === 'series-index') return '';
  return type;
}
function seriesDisplay(name: string): string {
  const s = name.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return ms ? 'Ground Truth' : 'Ground Truth';
  if (s.includes('guardrail')) return ms ? 'AI Guardrail' : 'AI Guardrail';
  if (s.includes('military') || s.includes('defence') || s.includes('defense')) return ms ? 'Military AI' : 'Military AI';
  if (s.includes('cloud') && s.includes('security')) return ms ? 'Cloud Security' : 'Cloud Security';
  return name;
}
function seriesPillClass(name: string): string {
  const s = name.toLowerCase();
  if (s.includes('ground') || s.includes('truth')) return 'mtj-pill--ground';
  if (s.includes('guardrail')) return 'mtj-pill--ai';
  if (s.includes('military') || s.includes('defence') || s.includes('defense')) return 'mtj-pill--mil';
  if (s.includes('cloud') && s.includes('security')) return 'mtj-pill--ground';
  return 'mtj-pill--ai';
}
function postHref(post: any): string {
  return localizedPath(`/posts/${post.id.split('/').pop()}/`, locale);
}
function getSeries(post: any): string {
  return (post.data.categories as string[])[0] ?? '';
}
function getType(post: any): string | undefined {
  return post.data.postType as string | undefined;
}

const dayFmt = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { day: '2-digit' });
const monShort = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', { month: 'short' });

const hrefForPage = (n: number) => localizedPath(n === 1 ? '/' : `/page/${n}/`, locale);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  pathWithoutLocale="/"
  homepage
>
  <div class="mtj-page">
    <main class="min-w-0" id="main" aria-label="Main Content">

      {bentoPosts.length > 0 && (
        <>
          <div class="mtj-section-label">{ms ? 'Terbaru' : 'Latest'}</div>

          <div class="mtj-bento">
            {bentoLong && (
              <a href={postHref(bentoLong)} class="mtj-bento__card mtj-bento--large">
                <span class={`mtj-pill ${seriesPillClass(getSeries(bentoLong))}`}>
                  {seriesDisplay(getSeries(bentoLong))} · {typeLabel(getType(bentoLong))}
                </span>
                <div class="mtj-bento__title">{bentoLong.data.title}</div>
                {bentoLong.data.description && (
                  <div class="mtj-bento__desc">{bentoLong.data.description}</div>
                )}
                <div class="mtj-bento__foot">
                  {dayFmt.format(bentoLong.data.pubDate)} {monShort.format(bentoLong.data.pubDate)} · {readTimeLabel(bentoLong)}
                </div>
              </a>
            )}

            {bentoMid && (
              <a href={postHref(bentoMid)} class="mtj-bento__card mtj-bento--medium">
                <span class={`mtj-pill ${seriesPillClass(getSeries(bentoMid))}`}>
                  {seriesDisplay(getSeries(bentoMid))} · {typeLabel(getType(bentoMid))}
                </span>
                <div class="mtj-bento__title">{bentoMid.data.title}</div>
                {bentoMid.data.description && (
                  <div class="mtj-bento__desc">{bentoMid.data.description}</div>
                )}
                <div class="mtj-bento__foot">
                  {dayFmt.format(bentoMid.data.pubDate)} {monShort.format(bentoMid.data.pubDate)} · {readTimeLabel(bentoMid)}
                </div>
              </a>
            )}

            {bentoSmall1 && (
              <a href={postHref(bentoSmall1)} class="mtj-bento__card mtj-bento--small">
                <span class={`mtj-pill ${seriesPillClass(getSeries(bentoSmall1))}`}>
                  {seriesDisplay(getSeries(bentoSmall1))}
                </span>
                <div class="mtj-bento__title">{bentoSmall1.data.title}</div>
                <div class="mtj-bento__foot">
                  {dayFmt.format(bentoSmall1.data.pubDate)} {monShort.format(bentoSmall1.data.pubDate)} · {readTimeLabel(bentoSmall1)}
                </div>
              </a>
            )}

            {bentoSmall2 && (
              <a href={postHref(bentoSmall2)} class="mtj-bento__card mtj-bento--small">
                <span class={`mtj-pill ${seriesPillClass(getSeries(bentoSmall2))}`}>
                  {seriesDisplay(getSeries(bentoSmall2))}
                </span>
                <div class="mtj-bento__title">{bentoSmall2.data.title}</div>
                <div class="mtj-bento__foot">
                  {dayFmt.format(bentoSmall2.data.pubDate)} {monShort.format(bentoSmall2.data.pubDate)} · {readTimeLabel(bentoSmall2)}
                </div>
              </a>
            )}
          </div>
        </>
      )}

      <PostList posts={remainingPosts} locale={locale} />

      <Pagination
        currentPage={1}
        lastPage={lastPage}
        hrefForPage={hrefForPage}
        locale={locale}
      />

    </main>

  </div>
</BaseLayout>
