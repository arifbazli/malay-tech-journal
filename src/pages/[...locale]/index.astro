---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '../../components/post/PostList.astro';
import Pagination from '../../components/ui/Pagination.astro';
import { readingTime } from '~/utils/reading-time';
import { SITE } from '~/config';
import { isoDate, localizedPath, useTranslations } from '~/i18n/utils';
import {
  categoryPath,
  getArticles,
  getSeriesSummaries,
  heroImageSrc,
  type Post,
} from '~/utils/posts';
import {
  postSeries,
  postTypeLabel,
  readTimeLabel,
  seriesInfo,
  type SeriesTone,
} from '~/utils/taxonomy';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const ms = locale === 'ms';

const articles = await getArticles(locale);
const seriesList = await getSeriesSummaries(locale);
const pageSize = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(articles.length / pageSize));
const pagePosts = articles.slice(0, pageSize);

// ── Featured grid: the four newest articles ──────────────────────────
const [lead, ...rest] = pagePosts.slice(0, 4);
const featuredRest = rest;
const remainingPosts = pagePosts.slice(4);
const leadCover = lead ? heroImageSrc(lead) : undefined;

const seriesBlurb: Record<SeriesTone, string> = {
  ground: t('home.seriesGround'),
  ai: t('home.seriesAi'),
  cloud: t('home.seriesCloud'),
  mil: t('home.seriesMil'),
  neutral: '',
};

const dateFmt = new Intl.DateTimeFormat(ms ? 'ms-MY' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const lastUpdated = articles[0]?.data.pubDate;

function postHref(post: Post): string {
  return localizedPath(`/posts/${post.id.split('/').pop()}/`, locale);
}
function minutes(post: Post): number {
  return readingTime((post as { body?: string }).body ?? '').minutes;
}
function pillText(post: Post): string {
  const series = seriesInfo(postSeries(post)).short;
  const type = postTypeLabel(post.data.postType, locale);
  return type ? `${series} · ${type}` : series;
}

const hrefForPage = (n: number) => localizedPath(n === 1 ? '/' : `/page/${n}/`, locale);
---

<BaseLayout title={SITE.title} description={t('site.description')} pathWithoutLocale="/" homepage>
  {leadCover && <link slot="head" rel="preload" as="image" href={leadCover} fetchpriority="high" />}
  <div class="mtj-page">
    <main class="min-w-0" id="main" aria-label="Main Content">
      {/* ── Hero: what this is, who it's for, where to start ─────────── */}
      <section class="mtj-hero" aria-labelledby="home-title">
        <p class="mtj-hero__eyebrow">
          <span class="mtj-hero__dot" aria-hidden="true"></span>
          {t('home.eyebrow')}
        </p>
        <h1 id="home-title" class="mtj-hero__title">
          {t('home.title')}
        </h1>
        <p class="mtj-hero__lede">{t('home.lede')}</p>
        <div class="mtj-hero__actions">
          {lead && (
            <a class="mtj-btn mtj-btn--primary" href={postHref(lead)}>
              {t('home.ctaRead')}
              <span aria-hidden="true">→</span>
            </a>
          )}
          <a class="mtj-btn" href={localizedPath('/categories/', locale)}>
            {t('home.ctaSeries')}
          </a>
          <a class="mtj-btn mtj-btn--ghost" href={localizedPath('/rss.xml', locale)}>
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            {t('home.ctaRss')}
          </a>
        </div>
        <dl class="mtj-hero__stats">
          <div>
            <dt>{t('home.statArticles')}</dt>
            <dd>{articles.length}</dd>
          </div>
          <div>
            <dt>{t('home.statSeries')}</dt>
            <dd>{seriesList.length}</dd>
          </div>
          {lastUpdated && (
            <div>
              <dt>{t('home.statUpdated')}</dt>
              <dd>
                <time datetime={isoDate(lastUpdated)}>{dateFmt.format(lastUpdated)}</time>
              </dd>
            </div>
          )}
        </dl>
      </section>

      {/* ── Featured: newest article large with cover, next three compact ── */}
      {lead && (
        <section aria-labelledby="home-latest">
          <h2 id="home-latest" class="mtj-section-label">
            {t('home.latest')}
          </h2>
          <div class="mtj-bento">
            <a href={postHref(lead)} class="mtj-bento__card mtj-bento--large">
              {leadCover && (
                <img
                  class="mtj-bento__cover"
                  src={leadCover}
                  alt=""
                  width="1200"
                  height="630"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              )}
              <div class="mtj-bento__content">
                <span class={`mtj-pill mtj-pill--${seriesInfo(postSeries(lead)).tone}`}>
                  {pillText(lead)}
                </span>
                <h3 class="mtj-bento__title">{lead.data.title}</h3>
                {lead.data.description && <p class="mtj-bento__desc">{lead.data.description}</p>}
                <div class="mtj-bento__foot">
                  <time datetime={isoDate(lead.data.pubDate)}>
                    {dateFmt.format(lead.data.pubDate)}
                  </time>{' '}
                  · {readTimeLabel(minutes(lead), locale)}
                </div>
              </div>
            </a>

            {featuredRest.map((post, index) => (
              <a
                href={postHref(post)}
                class:list={[
                  'mtj-bento__card',
                  index === 0 ? 'mtj-bento--medium' : 'mtj-bento--small',
                ]}
              >
                <span class={`mtj-pill mtj-pill--${seriesInfo(postSeries(post)).tone}`}>
                  {index === 0 ? pillText(post) : seriesInfo(postSeries(post)).short}
                </span>
                <h3 class="mtj-bento__title">{post.data.title}</h3>
                {index === 0 && post.data.description && (
                  <p class="mtj-bento__desc">{post.data.description}</p>
                )}
                <div class="mtj-bento__foot">
                  <time datetime={isoDate(post.data.pubDate)}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>{' '}
                  · {readTimeLabel(minutes(post), locale)}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* ── Series: give new readers a map, not just a feed ───────────── */}
      {seriesList.length > 0 && (
        <section aria-labelledby="home-series" class="mtj-series">
          <h2 id="home-series" class="mtj-section-label">
            {t('home.series')}
          </h2>
          <ul class="mtj-series__grid">
            {seriesList.map((s) => {
              const info = seriesInfo(s.name);
              return (
                <li>
                  <a
                    class={`mtj-series__card mtj-series__card--${info.tone}`}
                    href={categoryPath(locale, s.name)}
                  >
                    <span class="mtj-series__name">{info.name}</span>
                    {seriesBlurb[info.tone] && (
                      <span class="mtj-series__blurb">{seriesBlurb[info.tone]}</span>
                    )}
                    <span class="mtj-series__meta">
                      {s.count} {t('home.statArticles')} ·{' '}
                      <time datetime={isoDate(s.latest)}>{dateFmt.format(s.latest)}</time>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {remainingPosts.length > 0 && (
        <section aria-labelledby="home-archive">
          <h2 id="home-archive" class="mtj-section-label">
            {t('home.archive')}
          </h2>
          <PostList posts={remainingPosts} locale={locale} />
        </section>
      )}

      <Pagination currentPage={1} lastPage={lastPage} hrefForPage={hrefForPage} locale={locale} />
    </main>
  </div>
</BaseLayout>
