# Public site URL (no trailing slash). Used for canonical, OG, hreflang, sitemap.
SITE_URL=https://chirping-astro.example.com

# Sub-path the site is served from. Leave blank (or set to "/") for local
# dev and root-domain hosting. When deploying to GitHub Pages via Actions,
# this is automatically detected and configured for you!
#   examples:  BASE_PATH=/chirping-astro     (Manual GitHub Pages override)
#              BASE_PATH=                    (root domain or `bun run dev`)
BASE_PATH=

# --- Author / social handles ---
# Filling these in lets `src/config.ts` build all GitHub / Twitter / email
# URLs for you, so you never have to edit URLs by hand. Leave any of them
# blank to drop the corresponding social icon from the sidebar.
PUBLIC_GITHUB_HANDLE=arifbazli
# Optional repository slug for custom integrations (not used by the default footer theme link).
PUBLIC_GITHUB_REPO=malay-tech-journal
PUBLIC_TWITTER_HANDLE=
PUBLIC_CONTACT_EMAIL=

# --- Author identity (used by SITE.author + SOCIALS) ---
# Leave blank to use the built-in defaults below.
PUBLIC_AUTHOR_NAME=
PUBLIC_AUTHOR_URL=
# mailto: link target; leave blank to drop the email social.
PUBLIC_CONTACT_EMAIL=desktop_onsite@aol.com

# --- /projects page GitHub repo override ---
# Without this, src/utils/github-repo.ts uses PUBLIC_GITHUB_HANDLE +
# PUBLIC_GITHUB_REPO to resolve. Set this to fetch data from a different
# public repo on the /projects page (e.g. a separate showcase repo).
# PROJECTS_REPO=arifbazli/some-other-repo

# --- Giscus ---
# Master switch. Set "true" to enable.
PUBLIC_GISCUS_ENABLED=false
# Generate the values below at https://giscus.app
PUBLIC_GISCUS_REPO=your-handle/your-repo
PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxx
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxx
